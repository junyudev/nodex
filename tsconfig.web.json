{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/typescript/web.tsbuildinfo",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/renderer/**/*.d.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts"
  ],
  "exclude": ["src/shared/**/*.test.ts"]
}
