{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/typescript/tooling.tsbuildinfo"
  },
  "include": [
    "config/**/*.ts",
    "config/**/*.mts",
    "config/**/*.cts",
    "scripts/tooling/**/*",
    "scripts/testing/**/*",
    "scripts/**/*.test.*",
    "vitest.*.config.ts",
    "packages/agent-runtime/vite.config.ts",
    "playwright*.config.ts",
    "src/renderer/*.d.ts"
  ],
  "exclude": [
    "scripts/fixtures/tooling/**",
    "scripts/fixtures/effect-boundaries/**",
    "scripts/fixtures/renderer-command-boundaries/**"
  ]
}
