{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/typescript/tooling.tsbuildinfo"
  },
  "include": [
    "config/test-suites*.ts",
    "config/vitest-*.ts",
    "scripts/tooling/**/*.ts",
    "scripts/testing/**/*.ts",
    "scripts/testing/**/*.mts",
    "scripts/ci/**/*.test.ts",
    "vitest.*.config.ts",
    "config/renderer-worker-count*.ts",
    "src/renderer/*.d.ts"
  ],
  "exclude": ["scripts/fixtures/**"]
}
