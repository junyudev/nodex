{
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["@effect/platform-node", "effect"],
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "abortControllerInEffect": "off",
          "acquireReleaseDisposable": "off",
          "allOfMapToForEach": "off",
          "anyUnknownInErrorContext": "off",
          "apiStabilityLeak": "off",
          "asyncFunction": "off",
          "catchAllTagDispatchToCatchTag": "off",
          "catchAllToMapError": "off",
          "catchChainToFirstSuccessOf": "off",
          "catchConditionalRefailToCatchIf": "off",
          "catchDieToOrDie": "off",
          "catchIfTagToCatchTag": "off",
          "catchRefailToTapError": "off",
          "catchTagToCatchReason": "off",
          "catchToIgnore": "off",
          "catchToOrElseSucceed": "off",
          "catchUnfailableEffect": "off",
          "classSelfMismatch": "off",
          "cryptoRandomUUID": "off",
          "cryptoRandomUUIDInEffect": "off",
          "deterministicKeys": "off",
          "duplicatePackage": "off",
          "effectDoNotation": "off",
          "effectFnIife": "off",
          "effectFnImplicitAny": "off",
          "effectFnOpportunity": "off",
          "effectGenUsesAdapter": "off",
          "effectInFailure": "off",
          "effectInVoidSuccess": "off",
          "effectMapFlatten": "off",
          "effectMapVoid": "off",
          "effectSucceedWithVoid": "off",
          "experimentalApiUsage": "off",
          "extendsNativeError": "off",
          "flatMapConditionalToFilterOrFail": "off",
          "flatMapIgnoredParamToAndThen": "off",
          "flatMapToMap": "off",
          "floatingEffect": "off",
          "floatingEffectInVitest": "off",
          "genericEffectServices": "off",
          "globalConsole": "off",
          "globalConsoleInEffect": "off",
          "globalDate": "off",
          "globalDateInEffect": "off",
          "globalErrorInEffectCatch": "off",
          "globalErrorInEffectFailure": "off",
          "globalFetch": "off",
          "globalFetchInEffect": "off",
          "globalRandom": "off",
          "globalRandomInEffect": "off",
          "globalTimers": "off",
          "globalTimersInEffect": "off",
          "instanceOfSchema": "off",
          "layerMergeAllWithDependencies": "off",
          "lazyEffect": "off",
          "lazyPromiseInEffectSync": "off",
          "leakingRequirements": "off",
          "mapSomeToAsSome": "off",
          "matchEffectToMapBoth": "off",
          "matchEffectToMatch": "off",
