          "missingEffectContext": "off",
          "missingEffectError": "off",
          "missingEffectServiceDependency": "off",
          "missingLayerContext": "off",
          "missingPipeableSignature": "off",
          "missingReturnYieldStar": "off",
          "missingStarInYieldEffectGen": "off",
          "multipleCatchTag": "off",
          "multipleEffectProvide": "off",
          "nestedEffectGenYield": "off",
          "newPromise": "off",
          "newSchemaClass": "off",
          "nodeBuiltinImport": "off",
          "nonObjectEffectServiceType": "off",
          "obsoleteMatchImport": "off",
          "obsoleteSchemaImport": "off",
          "optionMatchToFromOption": "off",
          "outdatedApi": "off",
          "overriddenSchemaConstructor": "off",
          "preferSchemaOverJson": "off",
          "preferSchemaTypeProperty": "off",
          "preferSucceedSomeOrNone": "off",
          "preferTypedSchemaDecoder": "off",
          "preferUnsafeConstructor": "off",
          "processEnv": "off",
          "processEnvInEffect": "off",
          "promiseInEffectSuccess": "off",
          "provideLayerSucceedToProvideService": "off",
          "raceFirstWithSleepToTimeout": "off",
          "redundantMapError": "off",
          "redundantOrDie": "off",
          "redundantSchemaTagIdentifier": "off",
          "returnEffectInGen": "off",
          "runEffectInsideEffect": "off",
          "runOfExitToRunExit": "off",
          "schemaLiteralNonFinite": "off",
          "schemaNumber": "off",
          "schemaOpaqueInstanceMember": "off",
          "schemaStructWithTag": "off",
          "schemaSync": "off",
          "schemaSyncInEffect": "off",
          "schemaUnionOfLiterals": "off",
          "scopeInLayerEffect": "off",
          "serviceNotAsClass": "off",
          "strictBooleanExpressions": "off",
          "strictEffectProvide": "off",
          "syncToSucceed": "off",
          "timeoutCatchTagToTimeoutOrElse": "off",
          "tryCatchInEffectGen": "off",
          "unknownInEffectCatch": "off",
          "unnecessaryArrowBlock": "off",
          "unnecessaryEffectGen": "off",
          "unnecessaryFailYieldableError": "off",
          "unnecessaryPipe": "off",
