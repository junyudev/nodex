        "overrides": [
          {
            "include": [
              "packages/effect-codex-app-server/**/*.ts",
              "packages/effect-codex-app-server/**/*.tsx",
              "src/main/app/**/*.ts",
              "src/main/app/**/*.tsx",
              "src/main/core-runtime/**/*.ts",
              "src/main/core-runtime/**/*.tsx",
