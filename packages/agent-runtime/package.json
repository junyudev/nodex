{
  "name": "@nodex/agent-runtime",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/nodex/entry.ts",
    "./src/testUtils/*.setup.ts"
  ],
  "exports": {
    ".": "./src/nodex/index.ts",
    "./contracts": "./src/nodex/contracts.ts",
    "./orchestration/*": "./src/orchestration-v2/*.ts",
    "./config": "./src/config.ts",
    "./provider/*": "./src/provider/*.ts",
    "./persistence/*": "./src/persistence/*.ts",
    "./entry": "./src/nodex/entry.ts"
  },
  "scripts": {
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run --config vite.config.ts",
    "start": "node --import tsx src/nodex/entry.ts"
  },
