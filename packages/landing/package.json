{
  "name": "@nodex/landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "dev:worker": "wrangler dev --local",
    "deploy:worker": "wrangler deploy",
    "test": "cd ../.. && vp test run --config config/vitest.node.config.ts packages/landing",
    "typecheck": "tsc-rs --project tsconfig.json --noEmit",
    "typecheck:worker": "tsc-rs --project tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "7.1.7",
    "astro": "7.4.11",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261127.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "wrangler": "4.169.0"
  }
}
