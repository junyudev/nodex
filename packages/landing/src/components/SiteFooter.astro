---
import { CHANGELOG_URL, GITHUB_URL } from "../lib/site";
import { GitHubMark } from "../replica/icons";
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-6 py-8 text-[13px] text-ink-3">
    <div class="flex items-center gap-2.5">
      <img src="/nodex-icon.png" alt="" width="18" height="18" class="size-[18px] opacity-80" />
      <span>© 2026 Nodex · Apache-2.0</span>
    </div>
    <div class="flex items-center gap-5">
      <a href={GITHUB_URL} class="inline-flex items-center gap-1.5 hover:text-ink">
        <GitHubMark className="size-3.5" />
        GitHub
      </a>
      <a href={CHANGELOG_URL} class="hover:text-ink">Changelog</a>
      <a href="/privacy/" class="hover:text-ink">Privacy</a>
      <a href="/terms/" class="hover:text-ink">Terms</a>
    </div>
  </div>
</footer>
