---
import { CHANGELOG_URL, GITHUB_URL } from "../lib/site";
import { alternateLocale, localizedPath, type Locale, type LocalizedPage } from "../lib/locale";
import { GitHubMark } from "../replica/icons";
interface Props {
  locale?: Locale;
  page?: LocalizedPage;
}

const { locale = "en", page } = Astro.props;
const zh = locale === "zh-CN";
const other = alternateLocale(locale);
---

<nav class="sticky top-0 z-50 border-b border-line bg-page/70 backdrop-blur-xl" aria-label={zh ? "主导航" : "Primary"}>
  <div class="mx-auto flex h-14 max-w-[1200px] items-center justify-between gap-4 px-6">
    <a href={localizedPath("home", locale)} class="inline-flex items-center gap-2.5">
      <img src="/nodex-icon.png" alt="" width="26" height="26" class="size-[26px]" />
      <span class="text-[16px] font-semibold tracking-[-0.02em]">Nodex</span>
    </a>
    <div class="flex items-center gap-1 text-[14px] text-ink-2">
      <a href={CHANGELOG_URL} class="hidden rounded-full px-3 py-1.5 hover:text-ink sm:block">{zh ? "更新日志" : "Changelog"}</a>
      <a
        href={GITHUB_URL}
        aria-label={zh ? "在 GitHub 上查看 Nodex" : "Nodex on GitHub"}
        class="inline-flex items-center gap-1.5 rounded-full px-2 py-1.5 hover:text-ink sm:px-3"
      >
        <GitHubMark className="size-[18px] sm:size-4" />
        <span class="hidden sm:inline">GitHub</span>
      </a>
      {page && (
        <a href={localizedPath(page, other)} lang={other} hreflang={other} class="rounded-full px-2 py-1.5 whitespace-nowrap hover:text-ink sm:px-3">
          {zh ? "English" : "简体中文"}
        </a>
      )}
      <a href={localizedPath("download", locale)} class="ml-2 rounded-full bg-ink px-3.5 py-1.5 font-medium text-page hover:opacity-90">{zh ? "下载" : "Download"}</a>
    </div>
  </div>
</nav>
