---
import Button from '~/components/Button.astro'
import Circles from '~/components/Circles.astro'
import Description from '~/components/Description.astro'
import ArrowRightIcon from '~/icons/ArrowRightIcon.astro'
import { getLocale, getPath, getUI } from '~/utils/i18n'

const locale = getLocale(Astro)
const getLocalePath = getPath(locale)
const {
  components: { footer },
} = getUI(locale)
---

<footer
  id="footer"
  class="border-dark bg-dark text-paper relative flex w-full flex-col items-center overflow-hidden border-t px-4 py-12 lg:p-24"
  role="contentinfo"
  aria-label="Site footer"
>
  <div class="container flex w-full flex-col items-start justify-between gap-12">
    <section
      class="flex w-full flex-col gap-4 text-center lg:w-1/2 lg:text-left"
      aria-labelledby="footer-title"
    >
      <a href={getLocalePath('/')}>
        <Description id="footer-title" class="!text-paper text-6xl font-bold">
          {footer.title}
        </Description>
      </a>
      <Description class="mx-auto max-w-xl lg:mx-0">
        {footer.description}
      </Description>
    </section>

    <Button
      href="/download/"
      isPrimary
      class="bg-paper !text-dark h-fit w-fit place-self-center lg:place-self-start"
      aria-label={footer.download}
    >
      {footer.download}
      <ArrowRightIcon class="size-4" aria-hidden="true" />
    </Button>

    <nav class="w-full" aria-label="Footer navigation">
      <ul
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 opacity-80 lg:justify-start"
      >
        <li>
          <a
            href="https://github.com/junyudev/nodex"
            target="_blank"
            rel="noreferrer"
            class="font-normal"
          >
            {footer.links.github}
          </a>
        </li>
        <li>
          <a href={getLocalePath('/changelog/')} class="font-normal">
            {footer.links.changelog}
          </a>
        </li>
        <li>
          <a href={getLocalePath('/privacy/')} class="font-normal">
            {footer.links.privacy}
          </a>
        </li>
        <li>
          <a href={getLocalePath('/terms/')} class="font-normal">
            {footer.links.terms}
          </a>
        </li>
      </ul>
    </nav>

    <p class="w-full text-center opacity-60 lg:text-left">
      {footer.copyright}
    </p>

    <div class="absolute right-0 bottom-0" aria-hidden="true">
      <Circles white multiplier={0.7} class="mr-[-80px] mb-[-100px] ml-auto hidden lg:block" />
    </div>
  </div>
</footer>
