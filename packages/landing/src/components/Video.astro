---
type Props = {
  name: string
  class?: string
  label?: string
} & astroHTML.JSX.VideoHTMLAttributes

const { name, class: className, label, preload = 'none', ...rest }: Props = Astro.props
---

<video
  class:list={['w-fit', className]}
  aria-label={label}
  preload={preload}
  poster={`/media/${name}/poster.webp`}
  {...rest}
>
  <source src={`/media/${name}/video.webm`} type="video/webm" />
  <source src={`/media/${name}/video.mp4`} type="video/mp4" />
</video>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach(video => {
      video.removeAttribute('autoplay')
      video.pause()
    })
  }
</script>
