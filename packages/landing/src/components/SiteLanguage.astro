---
import { localizedPath } from "../lib/locale";

const englishHome = localizedPath("home", "en");
const chineseHome = localizedPath("home", "zh-CN");
---

<script id="site-language" is:inline define:vars={{ englishHome, chineseHome }}>
  const url = new URL(location.href);
  const root = document.documentElement;
  const storageKey = "nodex:site-language";

  function applyLanguage() {
    // A language redirect carries the original referrer's origin so this visit keeps its source.
    const from = url.searchParams.get("from");
    if (from !== null) {
      root.dataset.languageReferrer = from;
      url.searchParams.delete("from");
      history.replaceState(history.state, "", url);
    }

    const selection = url.searchParams.get("lang");
    if (selection === root.lang) {
      try {
        localStorage.setItem(storageKey, selection);
        url.searchParams.delete("lang");
        history.replaceState(history.state, "", url);
      } catch {
        // The explicit-language link still works when storage is unavailable.
      }
      return;
    }
    if (url.pathname !== englishHome) return;

    let preference;
    try {
      preference = localStorage.getItem(storageKey);
    } catch {
      // Browser language remains available when storage is blocked.
    }
    const useChinese = preference === "zh-CN" ||
      (preference !== "en" && /^zh(?:-|$)/i.test(navigator.language));
    if (!useChinese) return;

    root.dataset.languageRedirect = "true";
    url.pathname = chineseHome;
    url.searchParams.set("from", document.referrer ? new URL(document.referrer).origin : "");
    location.replace(url);
  }

  applyLanguage();
</script>
