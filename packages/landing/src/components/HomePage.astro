---
import type { Locale } from "../lib/locale";
import SiteFooter from "./SiteFooter.astro";
import SiteNav from "./SiteNav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Aerial from "../sections/Aerial.astro";
import Agents from "../sections/Agents.astro";
import Hero from "../sections/Hero.astro";
import Mobile from "../sections/Mobile.astro";
import Pages from "../sections/Pages.astro";
import Tidy from "../sections/Tidy.astro";
import Everything from "../sections/Everything.astro";
import FinalCta from "../sections/FinalCta.astro";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const zh = locale === "zh-CN";
---

<BaseLayout
  locale={locale}
  localizedPage="home"
  title={zh ? "Nodex：一个收件箱，所有智能体，一切存于本地" : "Nodex: One inbox. Every agent. All local."}
  description={zh ? "每个智能体都是一个节点。Nodex 是开源的本地工作空间：Claude Code、Codex、Antigravity 和 DeepSeek 从同一个收件箱接活、互相委派，再和你一起在本地页面里推进。" : undefined}
  imageAlt={zh ? "Nodex，每个智能体都是一个节点。鸟瞰视图里两个正在工作的聊天和它们的子智能体：Claude Code 把路由交给 Codex、测试交给 Antigravity、文档交给 OpenCode；Antigravity 的 Codex 子智能体又把截图交给 DeepSeek。支持 Claude Code、Codex、Antigravity、DeepSeek 和 OpenCode。" : undefined}
>
  <SiteNav locale={locale} page="home" />
  <main>
    <Hero locale={locale} />
    <Aerial locale={locale} />
    <Agents locale={locale} />
    <Pages locale={locale} />
    <Tidy locale={locale} />
    <Mobile locale={locale} />
    <Everything locale={locale} />
    <FinalCta locale={locale} />
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<script>
  import "../download-cta";
</script>
