---
import {
  SOCIAL_CARDS,
  SOCIAL_CARD_SCALE,
  SOCIAL_CARD_VIEWPORT,
  type SocialCardId,
} from "../lib/social-cards";
import { alternateLocale, localizedPath, type Locale, type LocalizedPage } from "../lib/locale";
import SiteLanguage from "../components/SiteLanguage.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  socialCard?: SocialCardId;
  noindex?: boolean;
  locale?: Locale;
  localizedPage?: LocalizedPage;
  imageAlt?: string;
  /** A page's own picture for link previews, in place of its social card. */
  image?: { url: string; width: number; height: number; alt: string };
}

const {
  title = "Nodex",
  description = "One inbox for every coding agent. Nodex plans each idea, routes it to Claude Code, Codex, Antigravity or DeepSeek, and keeps the results in local Pages you and your agents share.",
  ogTitle = title,
  socialCard = "home",
  noindex = false,
  locale = "en",
  localizedPage,
  imageAlt,
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const card = SOCIAL_CARDS[socialCard];
const preview = image ?? {
  // The card's content hash makes a re-recorded card a new URL, which link previews fetch again.
  url: new URL(`${card.file}?v=${__SOCIAL_CARD_VERSIONS__[card.file]}`, Astro.site).href,
  width: SOCIAL_CARD_VIEWPORT.width * SOCIAL_CARD_SCALE,
  height: SOCIAL_CARD_VIEWPORT.height * SOCIAL_CARD_SCALE,
  alt: imageAlt ?? card.alt,
};
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {localizedPage && <SiteLanguage />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {localizedPage && [locale, alternateLocale(locale)].map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(localizedPath(localizedPage, language), Astro.site).href} />
    ))}
    {localizedPage && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(localizedPage, "en"), Astro.site).href} />}
    <meta property="og:locale" content={locale === "zh-CN" ? "zh_CN" : "en_US"} />
    {localizedPage && <meta property="og:locale:alternate" content={locale === "zh-CN" ? "en_US" : "zh_CN"} />}
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta property="og:site_name" content="Nodex" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={preview.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={preview.width} />
    <meta property="og:image:height" content={preview.height} />
    <meta property="og:image:alt" content={preview.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview.url} />
    <meta name="twitter:image:alt" content={preview.alt} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        if (typeof window.matchMedia !== "function") return;
        const preference = window.matchMedia("(prefers-color-scheme: light)");
        const applyTheme = () => {
          document.documentElement.dataset.theme = preference.matches ? "light" : "dark";
        };
        applyTheme();
        preference.addEventListener("change", applyTheme);
      })();
    </script>
    <script is:inline>
      (() => {
        // Download actions follow the visitor's OS; macOS stays the default without a match.
        const platform =
          navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
        if (!/^win|windows/iu.test(platform)) return;
        document.documentElement.dataset.os = "windows";
      })();
    </script>
    <script>
      import "../analytics";
    </script>
  </head>
  <body class="min-h-screen bg-page font-sans text-ink antialiased">
    <slot />
  </body>
</html>
