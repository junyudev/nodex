---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title = "Nodex",
  description = "Local-first orchestration for coding agents. One board for tasks, threads, terminals, and history.",
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://nodex.jyu.app/og.png",
  ogType = "website",
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  twitterImage = ogImage,
  twitterCard = "summary_large_image",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={twitterImage} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        if (typeof window.matchMedia !== "function") return;
        const preference = window.matchMedia("(prefers-color-scheme: light)");
        const applyTheme = () => {
          document.documentElement.dataset.theme = preference.matches ? "light" : "dark";
        };
        applyTheme();
        preference.addEventListener("change", applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white font-sans text-[#1c1c1e] antialiased dark:bg-[#1c1c1e] dark:text-[#f5f5f7]">
    <slot />
  </body>
</html>
