---
import {
  SOCIAL_CARDS,
  SOCIAL_CARD_SCALE,
  SOCIAL_CARD_VIEWPORT,
  type SocialCardId,
} from "../lib/social-cards";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  socialCard?: SocialCardId;
  noindex?: boolean;
}

const {
  title = "Nodex",
  description = "One inbox for every coding agent. Nodex plans each idea, routes it to Claude Code, Codex or OpenCode, and keeps the results in local Pages you and your agents share.",
  ogTitle = title,
  socialCard = "home",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const card = SOCIAL_CARDS[socialCard];
const cardUrl = new URL(card.file, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta property="og:site_name" content="Nodex" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={SOCIAL_CARD_VIEWPORT.width * SOCIAL_CARD_SCALE} />
    <meta property="og:image:height" content={SOCIAL_CARD_VIEWPORT.height * SOCIAL_CARD_SCALE} />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={card.alt} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        if (typeof window.matchMedia !== "function") return;
        const preference = window.matchMedia("(prefers-color-scheme: light)");
        const applyTheme = () => {
          document.documentElement.dataset.theme = preference.matches ? "light" : "dark";
        };
        applyTheme();
        preference.addEventListener("change", applyTheme);
      })();
    </script>
    <script is:inline>
      (() => {
        // Download actions follow the visitor's OS; macOS stays the default without a match.
        const agent = navigator.userAgentData;
        const platform = agent?.platform || navigator.platform || navigator.userAgent;
        if (!/^win|windows/iu.test(platform)) return;
        const root = document.documentElement;
        root.dataset.os = "windows";
        agent
          ?.getHighEntropyValues?.(["architecture"])
          .then(({ architecture }) => {
            if (architecture === "arm") root.dataset.arch = "arm64";
          })
          .catch(() => {});
      })();
    </script>
    <script>
      import "../analytics";
    </script>
  </head>
  <body class="min-h-screen bg-page font-sans text-ink antialiased">
    <slot />
  </body>
</html>
