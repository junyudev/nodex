---
import AgentsDemo from "../demos/AgentsDemo";
import type { Locale } from "../lib/locale";
import Feature from "./Feature.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === "zh-CN";
---

<Feature
  eyebrow={zh ? "模型与订阅" : "Every agent, every plan"}
  title={zh ? "接入你已有的订阅，也能用免费模型" : "Bring the plans you pay for. Add the free ones."}
  flip
  points={zh ? [
    "内置 Claude Code、Codex 和 Antigravity；用你自己的 API key 接入 DeepSeek、Kimi、GLM 和 MiniMax；还有 OpenCode，以及 ACP Registry 中 Gemini CLI、Qwen Code 等 40 多个智能体。",
    "OpenCode 的免费模型和其他模型共用一个菜单。",
    "查看每个订阅 5 小时和每周的剩余额度，以及 API key 的余额。收件箱会参考这些来选择模型。",
    "对话中可以切换模型，下一条消息由新的智能体接手。",
  ] : [
    "Claude Code, Codex and Antigravity built in. DeepSeek, Kimi, GLM and MiniMax on your own API key. OpenCode and 40+ more agents from the ACP Registry, like Gemini CLI and Qwen Code.",
    "OpenCode’s free models sit in the same model menu as everything else.",
    "See what’s left of each plan’s 5-hour and weekly limits, and of each API key’s balance. The Inbox weighs it before it picks a model.",
    "Switch models mid-chat: your next message hands the conversation to the new Agent.",
  ]}
>
  <Fragment slot="body">
    {zh ? "每个服务只需登录一次，所有模型都在同一个菜单里。Nodex 会显示各账号的剩余额度，让你把高阶模型用在关键任务上，其余工作交给免费模型。" : "Sign in once per provider and every model is one menu away. Nodex shows how much of each plan is left, so the expensive model goes where it matters and a free one takes the rest."}
  </Fragment>
  <div lang={locale}><AgentsDemo locale={locale} client:visible /></div>
</Feature>
