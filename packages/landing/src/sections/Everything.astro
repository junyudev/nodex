---
import type { Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === "zh-CN";
const items = zh ? [
  ["自动化", "定时任务、心跳和 GitHub 事件都能开始工作，也可以先在收件箱里问你。"],
  ["GitHub", "在页面里关注 Issue 和 PR，审查意见和 CI 结果会回到负责的聊天。"],
  ["Git 工作树", "每个页面的工作都有自己的工作树，由你配置的环境完成初始化。"],
  ["审查", "在会话旁查看未暂存、已暂存、分支和上一轮的改动。"],
  ["浏览器", "预览本地服务、为聊天做标注，也可以让智能体操作浏览器。"],
  ["终端", "在项目或会话所属目录中使用终端。"],
  ["搜索", "在新标签页或命令面板中查找聊天、页面、文件及其内容。"],
  ["团队空间", "在你自己的主机上，和团队共享页面、看板和收件箱。"],
  ["画布", "在页面里插入白板，或在独立标签页中打开。"],
  ["历史和快照", "恢复页面的历史版本，或用快照恢复整个工作空间。"],
  ["导入会话", "导入已有的 Codex、Claude Code 和 Antigravity 对话。"],
  ["技能和插件", "技能、插件和 MCP 服务，可在支持它们的智能体之间共用。"],
] : [
  ["Automations", "Schedules, heartbeats and GitHub events that start work, or ask in the Inbox first."],
  ["GitHub", "Follow issues and PRs from a Page; reviews and CI results come back to its chat."],
  ["Worktrees", "Each Page’s work gets its own checkout, set up by your Environment."],
  ["Review", "Unstaged, staged, branch and last-turn diffs, right beside the chat."],
  ["Browser", "Preview your local server, mark it up for a chat, or let agents drive it."],
  ["Terminal", "Real terminals in the Project’s or the chat’s folder."],
  ["Search", "Find chats, Pages, files and what’s in them from a New tab or the palette."],
  ["Team Spaces", "Share Pages, Boards and an Inbox with your team on a host you run."],
  ["Canvas", "A whiteboard Block, inline in a Page or in its own tab."],
  ["History & snapshots", "Restore a Page revision, or the whole workspace from a snapshot."],
  ["Bring your chats", "Import existing Codex, Claude Code and Antigravity conversations."],
  ["Skills & plugins", "Skills, plugins and MCP servers, shared by the agents that support them."],
];
---

<section class="mx-auto max-w-[1200px] px-6 py-16 sm:py-20">
  <div class="flex max-w-[720px] flex-col gap-4">
    <p class="font-mono text-[12px] tracking-[0.14em] text-ink-3 uppercase">{zh ? "智能体之外的工具" : "Everything around the agent"}</p>
    <h2 class="text-[34px] leading-[1.08] font-semibold tracking-[-0.035em] text-balance sm:text-[44px]">
      {zh ? "从想法到交付，都在同一个窗口" : "The rest of the job, in the same window."}
    </h2>
  </div>
  <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map(([title, body]) => (
        <div class="flex flex-col gap-1.5 bg-page p-6">
          <span class="text-[15px] font-medium text-ink">{title}</span>
          <span class="text-[14px] leading-relaxed text-ink-2">{body}</span>
        </div>
      ))
    }
  </div>
</section>
