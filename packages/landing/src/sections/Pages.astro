---
import PagesDemo from "../demos/PagesDemo";
import Feature from "./Feature.astro";
---

<Feature
  eyebrow="Pages, not transcripts"
  title="The work lands in Pages you both edit."
  wide
>
  <Fragment slot="body">
    Every Inbox message is already a Page on your Board. Hand it to a chat and it moves from Triage to Build; agents query the Board, update properties, and write findings straight into the Page while it’s open, attaching reports, screenshots and traces that open in a tab beside it. When you’re happy, mark it done and it
    ships.
  </Fragment>
  <PagesDemo client:visible />
</Feature>
