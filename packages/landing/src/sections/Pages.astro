---
import PagesDemo from "../demos/PagesDemo";
import type { Locale } from "../lib/locale";
import Feature from "./Feature.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === "zh-CN";
---

<Feature
  eyebrow={zh ? "用页面管理工作" : "Pages, not transcripts"}
  title={zh ? "你和智能体在同一个页面里推进工作" : "The work lands in Pages you both edit."}
  wide
>
  <Fragment slot="body">
    {zh ? "收件箱里的每条消息都已经是一个页面。交给某个项目的会话后，它会出现在该项目的看板上并进入「进行中」，卡片上写明是哪个智能体在处理。智能体能查询看板，把结果直接写入打开着的页面，再把报告、截图和追踪记录挂到页面的文件下。工作完成后，页面进入「审查中」，等你点「接受」。" : "Every Inbox message is already a Page. Hand it to a Project’s chat and it lands on that Project’s Board, In Progress, with the Agent at work named on its card. Agents query the Board, write findings straight into the Page while it’s open, and hang reports, screenshots and traces beneath its Files. When the work is ready, the Page moves to In Review and waits for you to Accept it."}
  </Fragment>
  <div lang={locale}><PagesDemo locale={locale} client:visible /></div>
</Feature>
