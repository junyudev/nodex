---
import PagesDemo from "../demos/PagesDemo";
import type { Locale } from "../lib/locale";
import Feature from "./Feature.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === "zh-CN";
---

<Feature
  eyebrow={zh ? "用页面管理工作" : "Pages, not transcripts"}
  title={zh ? "你和智能体在同一个页面里推进工作" : "The work lands in Pages you both edit."}
  wide
>
  <Fragment slot="body">
    {zh ? "收件箱里的每条消息都是看板上的一个页面。交给会话后，它会从「待分流」进入「进行中」。智能体能查询看板、更新属性，并直接把结果写入当前页面。报告、截图和追踪记录可以作为附件，在旁边的标签页打开。确认结果后，就可以将任务标为完成。" : "Every Inbox message is already a Page on your Board. Hand it to a chat and it moves from Triage to Doing; agents query the Board, update properties, and write findings straight into the Page while it’s open, attaching reports, screenshots and traces that open in a tab beside it. When you’re happy, mark it done and it ships."}
  </Fragment>
  <div lang="en"><PagesDemo client:visible /></div>
</Feature>
