---
import { BREW_COMMAND, DOWNLOAD_URL, VERSION_LABEL } from "../lib/site";

interface Props {
  align?: "center" | "start";
  /** The release line under the buttons; the hero leaves it to the closing call. */
  stamp?: boolean;
}

const { align = "center", stamp = true } = Astro.props;
---

<div class:list={["flex flex-col gap-4", align === "center" ? "items-center" : "items-start"]}>
  <div class:list={["flex max-w-full flex-wrap items-center gap-3", align === "center" && "justify-center"]}>
    <a
      href={DOWNLOAD_URL}
      data-download
      class="inline-flex h-11 items-center gap-2 rounded-full bg-ink px-5 text-[15px] font-medium text-page transition-transform hover:scale-[1.02] active:scale-[0.98]"
    >
      <svg viewBox="0 0 17 20" class="-mt-0.5 size-[17px]" fill="currentColor" aria-hidden="true">
        <path d="M14.1 10.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-1.9-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9C3.8 5 2.2 6 1.3 7.6c-1.8 3.1-.5 7.8 1.3 10.3.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.3.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1.1-2.8-4.4Zm-2.5-7.4c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5Z" />
      </svg>
      Download for macOS
    </a>
    <div class="inline-flex h-11 max-w-full items-center rounded-full border border-line bg-raised/60 pl-4 backdrop-blur">
      <span class="mr-2 font-mono text-[13px] text-ink-3" aria-hidden="true">$</span>
      <code class="min-w-0 truncate font-mono text-[13px] text-ink-2 select-all">{BREW_COMMAND}</code>
      <button
        type="button"
        class="landing-brew-copy group ml-1 flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full text-ink-3 hover:text-ink"
        aria-label="Copy install command"
        data-command={BREW_COMMAND}
      >
        <svg class="size-4 group-[.copied]:hidden" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"></rect>
          <path d="M3 10.5V3a1.5 1.5 0 0 1 1.5-1.5H11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
        </svg>
        <svg class="hidden size-4 text-status-ship group-[.copied]:block" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
  {
    stamp ? (
      <p class="font-mono text-[12px] tracking-wide text-ink-3">
        Free & open source · <span class="landing-version-label">{VERSION_LABEL}</span> beta ·
        Apple silicon · macOS 15+
      </p>
    ) : null
  }
</div>
