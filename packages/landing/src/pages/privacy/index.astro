---
import Layout from '~/layouts/Layout.astro'
---

<Layout
  title="Privacy - Nodex"
  description="Privacy notes for the Nodex public site."
>
  <main class="container grid gap-8 py-16 lg:py-32">
    <section class="grid gap-4">
      <h1 class="font-junicode text-dark text-6xl leading-none font-semibold sm:text-8xl">
        Privacy
      </h1>
      <p class="max-w-3xl opacity-80">
        Nodex is a local-first desktop app. This static site does not require an account,
        does not host your projects, and links downloads to GitHub Releases.
      </p>
    </section>
  </main>
</Layout>
