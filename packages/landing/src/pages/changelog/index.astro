---
import { readFileSync } from "node:fs";
import {
  formatReleaseDate,
  inlineHtml,
  releasesToShow,
  splitEntry,
  type ChangelogCategory,
  type ChangelogRelease,
} from "../../changelog";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GITHUB_URL } from "../../lib/site";
import { ChevronDownIcon, GitHubMark } from "../../replica/icons";

const releases = releasesToShow(
  readFileSync(new URL("../../../../../CHANGELOG.md", import.meta.url), "utf8"),
);
const latest = releases.find((release) => release.version !== null);

// Each kind of change keeps the color its status has in the app.
const TONE: Record<string, string> = {
  Added: "bg-status-ship",
  Changed: "bg-status-build",
  Deprecated: "bg-ink-3",
  Removed: "bg-status-review",
  Fixed: "bg-status-plan",
  Security: "bg-free",
};

const anchorOf = (release: ChangelogRelease) =>
  release.version === null ? "unreleased" : `v${release.version}`;
const seriesOf = (release: ChangelogRelease) =>
  release.version?.split(".").slice(0, 2).join(".") ?? "next";
// The rail drops the year while it is the latest release's year.
function railDate(release: ChangelogRelease): string {
  if (!release.date) return "";
  const date = formatReleaseDate(release.date);
  return release.date.slice(0, 4) === latest?.date?.slice(0, 4) ? date.replace(/, \d{4}$/, "") : date;
}

// What is new reads in full: the release in development and the latest one show every addition
// and change. Everything else shows its first few entries and opens the rest on request.
function visibleCount(release: ChangelogRelease, category: ChangelogCategory): number {
  const current = release.version === null || release === latest;
  if (current) return category.title === "Added" || category.title === "Changed" ? Infinity : 5;
  return 3;
}

const entryClass =
  "text-[15px] leading-[1.7] text-pretty text-ink-2 [&_code]:rounded-[5px] [&_code]:bg-ink/[0.07] [&_code]:px-[0.32em] [&_code]:py-[0.06em] [&_code]:font-mono [&_code]:text-[0.84em] [&_code]:text-ink";
---

<BaseLayout
  title="Changelog | Nodex"
  ogTitle="Nodex Changelog"
  description="Every change in Nodex, release by release, newest first."
>
  <SiteNav />
  <main class="mx-auto w-full max-w-[1120px] px-6 pt-10 pb-24 sm:pt-14">
    <header
      class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-b border-line pb-7"
    >
      <div>
        <h1 class="text-[32px] leading-none font-semibold tracking-[-0.035em] sm:text-[36px]">
          Changelog
        </h1>
        <p class="mt-3 text-[15px] text-ink-2">Every change in Nodex, newest first.</p>
      </div>
      <a
        href={`${GITHUB_URL}/releases`}
        class="inline-flex h-8 items-center gap-1.5 rounded-full px-3 text-[13px] text-ink-2 ring-1 ring-line transition-colors hover:text-ink hover:ring-ink/20"
      >
        <GitHubMark className="size-4" />
        Follow releases
      </a>
    </header>

    <div class="mt-10 lg:grid lg:grid-cols-[208px_minmax(0,1fr)] lg:gap-14">
      <nav aria-label="Releases" class="hidden lg:block">
        <ol
          data-release-rail
          class="sticky top-24 -mx-2.5 max-h-[calc(100vh-8rem)] overflow-y-auto overscroll-contain pb-6 [scrollbar-width:none]"
        >
          {
            releases.map((release, index) => (
              <li
                class:list={[
                  index > 0 && seriesOf(release) !== seriesOf(releases[index - 1]!) && "mt-3",
                ]}
              >
                <a
                  href={`#${anchorOf(release)}`}
                  data-release-link={anchorOf(release)}
                  class="flex items-baseline justify-between gap-3 rounded-[10px] px-2.5 py-[5px] text-[13px] text-ink-3 transition-colors hover:text-ink aria-[current=true]:bg-ink/[0.055] aria-[current=true]:text-ink"
                >
                  <span class="font-medium tabular-nums">{release.version ?? "Unreleased"}</span>
                  <span class="text-[12px] tabular-nums opacity-80">{railDate(release)}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="min-w-0 max-w-[720px]">
        {
          releases.map((release) => (
            <article
              id={anchorOf(release)}
              data-release
              class="scroll-mt-24 border-t border-line pt-10 pb-14 first:border-t-0 first:pt-0"
            >
              <header class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <h2 class="text-[26px] leading-tight font-semibold tracking-[-0.03em]">
                  <a href={`#${anchorOf(release)}`}>{release.label}</a>
                </h2>
                {release.version === null ? (
                  <span
                    data-release-status
                    class="rounded-full bg-status-build/12 px-2 py-0.5 text-[12px] font-medium text-status-build"
                  >
                    In development
                  </span>
                ) : release === latest ? (
                  <span
                    data-release-status
                    class="rounded-full bg-status-ship/12 px-2 py-0.5 text-[12px] font-medium text-status-ship"
                  >
                    Latest
                  </span>
                ) : null}
                {release.date ? (
                  <time datetime={release.date} class="ml-auto text-[14px] text-ink-3 tabular-nums">
                    {formatReleaseDate(release.date)}
                  </time>
                ) : null}
              </header>
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-ink-3">
                {release.categories.map((category) => (
                  <span class="inline-flex items-center gap-1.5 tabular-nums">
                    <span class:list={["size-1.5 rounded-full", TONE[category.title] ?? "bg-ink-3"]} />
                    {category.items.length} {category.title.toLowerCase()}
                  </span>
                ))}
              </p>

              {release.categories.map((category) => {
                const shown = visibleCount(release, category);
                const entries = category.items.map((item) => splitEntry(item.text));
                const list = (items: typeof entries) =>
                  items.map(({ lead, rest }) => (
                    <li class={entryClass}>
                      <span class="text-ink" set:html={inlineHtml(lead)} />
                      {rest ? " " : null}
                      {rest ? <Fragment set:html={inlineHtml(rest)} /> : null}
                    </li>
                  ));
                const more = entries.slice(shown);
                return (
                  <section class="mt-9">
                    <h3 class="flex items-center gap-2 text-[13px] font-medium text-ink">
                      <span class:list={["size-2 rounded-full", TONE[category.title] ?? "bg-ink-3"]} />
                      {category.title}
                      <span class="font-normal text-ink-3 tabular-nums">{category.items.length}</span>
                    </h3>
                    <ul class="mt-4 flex flex-col gap-4">{list(entries.slice(0, shown))}</ul>
                    {more.length > 0 ? (
                      <details class="group">
                        <summary class="mt-4 inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full px-0.5 text-[13px] font-medium text-ink-2 transition-colors select-none group-open:hidden hover:text-ink [&::-webkit-details-marker]:hidden">
                          Show {more.length} more
                          <ChevronDownIcon className="size-3.5" />
                        </summary>
                        <ul class="mt-4 flex flex-col gap-4">{list(more)}</ul>
                      </details>
                    ) : null}
                  </section>
                );
              })}
            </article>
          ))
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  // The rail marks the release being read: the last one whose top has passed a line a third of
  // the way down the window, and keeps it in view as the rail scrolls.
  const rail = document.querySelector<HTMLElement>("[data-release-rail]");
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-release-link]")].map((link) => [
      link.dataset.releaseLink!,
      link,
    ]),
  );
  const releases = [...document.querySelectorAll<HTMLElement>("article[data-release]")];
  let current: HTMLAnchorElement | undefined;
  let frame = 0;

  const update = () => {
    frame = 0;
    const line = window.innerHeight / 3;
    let reading = releases[0];
    for (const release of releases) {
      if (release.getBoundingClientRect().top > line) break;
      reading = release;
    }
    const link = reading ? links.get(reading.id) : undefined;
    if (!link || link === current) return;
    current?.removeAttribute("aria-current");
    link.setAttribute("aria-current", "true");
    current = link;
    if (!rail) return;
    const bounds = rail.getBoundingClientRect();
    const target = link.getBoundingClientRect();
    if (target.top < bounds.top) rail.scrollTop -= bounds.top - target.top + 12;
    else if (target.bottom > bounds.bottom) rail.scrollTop += target.bottom - bounds.bottom + 12;
  };

  if (rail && releases.length > 0) {
    update();
    window.addEventListener(
      "scroll",
      () => {
        frame ||= requestAnimationFrame(update);
      },
      { passive: true },
    );
  }
</script>
