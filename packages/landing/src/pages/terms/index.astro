---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Terms | Nodex" description="Website terms for the Nodex landing site.">
  <div class="flex min-h-screen flex-col">
    <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-6 py-12 sm:px-10">
      <a href="/" class="mb-10 inline-flex items-center gap-2 text-sm opacity-60 hover:opacity-100">← Back to Nodex</a>

      <article class="py-7">
        <h1 class="text-4xl font-semibold tracking-[-0.045em]">Terms</h1>
        <p class="mt-3 text-sm opacity-50">Last updated: March 17, 2026</p>

        <div class="mt-8 space-y-7 text-[15px] leading-7 [&_h2]:mb-2 [&_h2]:text-lg [&_h2]:font-medium [&_h2]:tracking-tight [&_p]:opacity-70">
          <section>
            <h2>Scope</h2>
            <p>
              These terms apply to your use of the Nodex landing site at `nodex.jyu.app`. They
              govern the website itself, not any separate software license, notices, or release
              artifacts that may accompany the application.
            </p>
          </section>

          <section>
            <h2>No warranty</h2>
            <p>
              The site and linked download information are provided on an “as is” and “as
              available” basis. Availability, release timing, and linked resources may change
              without notice.
            </p>
          </section>

          <section>
            <h2>External services</h2>
            <p>
              The site links to third-party services including GitHub and Homebrew. Your use of
              those services is governed by their own terms and policies.
            </p>
          </section>

          <section>
            <h2>Acceptable use</h2>
            <p>
              Do not misuse the site, attempt to interfere with its availability, or use it in
              ways that violate applicable law.
            </p>
          </section>

          <section>
            <h2>Changes</h2>
            <p>
              If these site terms change, the updated version will be published here with a
              revised date.
            </p>
          </section>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>
