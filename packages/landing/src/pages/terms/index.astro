---
import Layout from '~/layouts/Layout.astro'
---

<Layout
  title="Terms - Nodex"
  description="Terms notes for the Nodex public site."
>
  <main class="container grid gap-8 py-16 lg:py-32">
    <section class="grid gap-4">
      <h1 class="font-junicode text-dark text-6xl leading-none font-semibold sm:text-8xl">
        Terms
      </h1>
      <p class="max-w-3xl opacity-80">
        Nodex is distributed through GitHub Releases while in beta. Use the project source,
        release notes, and license files for the current software terms.
      </p>
    </section>
  </main>
</Layout>
