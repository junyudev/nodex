{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "../../.cache/typescript/storybook.tsbuildinfo"
  },
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx", "../../src/renderer/*.d.ts"],
  "extends": "../../tsconfig.base.json"
}
