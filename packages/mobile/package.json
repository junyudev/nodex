{
  "name": "@nodex/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Nodex Mobile: capture to the Inbox and follow chats from a phone",
  "main": "index.ts",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client --scheme nodex-mobile-dev",
    "ios": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --no-install --platform ios && APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --no-install --platform android && APP_VARIANT=development expo run:android",
    "ios:release": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --no-install --platform ios && APP_VARIANT=production expo run:ios --configuration Release --no-bundler",
    "android:release": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --no-install --platform android && APP_VARIANT=production expo run:android --variant release --no-bundler",
    "ios:testflight": "bash scripts/testflight.sh",
    "test": "cd ../.. && vp test run --config config/vitest.node.config.ts packages/mobile/src",
    "typecheck": "tsc-rs --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@expo/metro-runtime": "58.0.15",
    "@legendapp/list": "3.7.1",
    "@noble/hashes": "2.4.0",
    "@nodex/mobile-protocol": "workspace:*",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "clsx": "^2.1.1",
    "effect": "4.0.6",
    "expo": "58.0.20",
    "expo-application": "58.1.2",
    "expo-blur": "58.0.5",
    "expo-build-properties": "58.0.11",
    "expo-camera": "58.0.13",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.16",
    "expo-file-system": "58.0.12",
    "expo-glass-effect": "58.0.5",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.17",
    "expo-image-manipulator": "58.0.15",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-notifications": "58.1.8",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.20",
    "expo-splash-screen": "58.0.11",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "file:deps/react-native-enriched-markdown-1.2.0.tgz",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "uniwind": "1.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.21",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "enriched-markdown": {
    "enableMath": true,
    "enableVideo": false
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-enriched-markdown",
        "react-native-keyboard-controller",
        "typescript"
      ]
    }
  }
}
