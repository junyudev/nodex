    "ccusage",
    "claude-code",
    "codex",
    "tokens",
    "usage"
  ],
  "homepage": "https://nodex.jyu.app",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junyudev/nodex.git",
    "directory": "packages/nodex-card"
  },
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc-rs --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "ccusage": "20.1.2"
  },
  "devDependencies": {
    "@formatjs/intl": "6.1.5",
    "@nodex/insights-cards": "workspace:*"
